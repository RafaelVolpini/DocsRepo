<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:matter="http://matter.com.br/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Atendimento de chamados técnicos" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Abertura e tratamento de chamados técnicos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Solicitante" name="Solicitante">
        <bpmn:flowNodeRef>Start_Chamado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N1" name="N1">
        <bpmn:flowNodeRef>Task_Analisar_N1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Resolvido_N1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Encerrar_N1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_N1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N2" name="N2">
        <bpmn:flowNodeRef>Task_Analisar_N2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Resolvido_N2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Encerrar_N2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_N2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N3" name="N3">
        <bpmn:flowNodeRef>Task_Analisar_N3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Resolvido_N3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Encerrar_N3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_N3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Gestor" name="Gestor">
        <bpmn:flowNodeRef>Task_Atuar_Gestor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar_Excecao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Gestor</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Chamado" name="Necessidade de suporte identificada">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Registrar" name="Registrar chamado">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Analisar_N1" name="Analisar chamado no N1">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Resolvido_N1" name="Chamado resolvido no N1?" matter:labelSide="top">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Encerrar_N1" name="Encerrar chamado">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_N1" name="Chamado encerrado no N1">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Analisar_N2" name="Analisar chamado no N2">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Resolvido_N2" name="Chamado resolvido no N2?" matter:labelSide="top">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Encerrar_N2" name="Encerrar chamado">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_N2" name="Chamado encerrado no N2">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Analisar_N3" name="Analisar chamado no N3">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Resolvido_N3" name="Chamado resolvido no N3?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Encerrar_N3" name="Encerrar chamado">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_N3" name="Chamado encerrado no N3">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Atuar_Gestor" name="Avaliar chamado escalado">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Registrar_Excecao" name="Registrar decisão e orientar tratamento">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Gestor" name="Tratamento concluído pelo gestor">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Chamado" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Registrar" targetRef="Task_Analisar_N1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Analisar_N1" targetRef="Gateway_Resolvido_N1" />
    <bpmn:sequenceFlow id="Flow_4" name="Sim" sourceRef="Gateway_Resolvido_N1" targetRef="Task_Encerrar_N1" />
    <bpmn:sequenceFlow id="Flow_5" name="Não — N2" sourceRef="Gateway_Resolvido_N1" targetRef="Task_Analisar_N2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Encerrar_N1" targetRef="End_N1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Analisar_N2" targetRef="Gateway_Resolvido_N2" />
    <bpmn:sequenceFlow id="Flow_8" name="Sim" sourceRef="Gateway_Resolvido_N2" targetRef="Task_Encerrar_N2" />
    <bpmn:sequenceFlow id="Flow_9" name="Não — escalar N3" sourceRef="Gateway_Resolvido_N2" targetRef="Task_Analisar_N3" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Encerrar_N2" targetRef="End_N2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Analisar_N3" targetRef="Gateway_Resolvido_N3" />
    <bpmn:sequenceFlow id="Flow_12" name="Sim" sourceRef="Gateway_Resolvido_N3" targetRef="Task_Encerrar_N3" />
    <bpmn:sequenceFlow id="Flow_13" name="Não: escalar para gestor" sourceRef="Gateway_Resolvido_N3" targetRef="Task_Atuar_Gestor" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Encerrar_N3" targetRef="End_N3" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Atuar_Gestor" targetRef="Task_Registrar_Excecao" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Registrar_Excecao" targetRef="End_Gestor" />
  </bpmn:process>
